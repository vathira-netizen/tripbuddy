# Copy to .env and fill in real values. Never commit .env.

# Supabase Postgres connection string, e.g.:
# postgres://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgres://user:password@localhost:5432/tripbuddy

# Supabase project settings.
#
#   SUPABASE_URL — required. Django derives the JWKS endpoint from it
#     ({SUPABASE_URL}/auth/v1/.well-known/jwks.json) to fetch the PUBLIC keys
#     that verify access tokens. Current Supabase projects sign tokens
#     asymmetrically (ES256), so no shared secret is involved.
#
#   SUPABASE_JWT_SECRET — only needed by LEGACY projects that still sign with a
#     shared HS256 secret. It is Settings > API > JWT Secret (a long random
#     string), NOT the service_role key — the service_role key is itself a JWT,
#     and pasting it here makes every login fail with 401. Leave blank if your
#     project uses signing keys (check /auth/v1/.well-known/jwks.json: if it
#     lists a key, you are on the asymmetric path).
#
#   SUPABASE_SERVICE_ROLE_KEY bypasses Row-Level Security: backend-only, never
#     expose it to the browser or prefix it NEXT_PUBLIC_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=change-me

# Django
DJANGO_SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS: comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Nominatim/OSM geocoding (profile onboarding). Optional; their usage policy
# asks for an identifying User-Agent with contact details.
# NOMINATIM_USER_AGENT=TripBuddy/1.0 (you@example.com)

# AI itinerary generator (Phase 6). BACKEND-ONLY — never expose these to the
# browser or put them in a NEXT_PUBLIC_ variable. Without GROQ_API_KEY the
# generate endpoint returns 503 and the rest of the app is unaffected.
# Provider is swappable: point BASE_URL/MODEL/KEY at any OpenAI-compatible
# endpoint (Groq by default; e.g. Gemini's OpenAI-compatible endpoint, xAI
# Grok, etc.).
# LLM_PROVIDER=groq
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b
# GROQ_API_KEY=your-groq-api-key
# LLM_TIMEOUT=30
