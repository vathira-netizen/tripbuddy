# Copy to .env and fill in real values. Never commit .env.

# Supabase Postgres connection string, e.g.:
# postgres://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgres://user:password@localhost:5432/tripbuddy

# Supabase project settings
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=change-me
SUPABASE_SERVICE_ROLE_KEY=change-me

# Django
DJANGO_SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS: comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:3000
